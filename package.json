{
  "name": "withink",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=24.11.1 <24.13.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:app": "pnpm --filter @withink/app dev",
    "dev:docs": "pnpm --filter @withink/docs dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "start:app": "pnpm --filter @withink/app start",
    "start:docs": "pnpm --filter @withink/docs start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.4.0",
    "prettier": "3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "turbo": "^2.5.0"
  }
}
