# ─────────────────────────────────────────────────────────────
# Withink V2 — Environment Variables
# Copy to `.env.local` and fill in. Never commit real secrets.
# All variables are validated at startup by src/config/env.ts (Zod).
# ─────────────────────────────────────────────────────────────

# Runtime -------------------------------------------------------
# "true" selects the production database + strips the dev asset prefix.
IS_PROD=false

# Database (MongoDB) -------------------------------------------
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net

# Authentication (Better Auth) ---------------------------------
# 32+ char random string. Generate: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Public base URL of the app (used for callbacks).
BETTER_AUTH_URL=http://localhost:3000

# OAuth — Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cache (Upstash Redis, optional — app works without it) -------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Object storage (Cloudflare R2) -------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Server-side public asset base (e.g. https://assets.withink.me)
R2_PUBLIC_URL=https://assets.withink.me
# Client-exposed public asset base (must mirror R2_PUBLIC_URL)
NEXT_PUBLIC_R2_PUBLIC_URL=https://assets.withink.me

# Email (Resend) -----------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=Withink <noreply@withink.me>
# Where feedback / issue reports are delivered.
CONTACT_EMAIL=team@withink.me

# Encryption ---------------------------------------------------
# 64 hex chars = 32 bytes (AES-256). Generate: `openssl rand -hex 32`
ENCRYPTION_KEY=
