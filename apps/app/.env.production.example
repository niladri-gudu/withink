# ─────────────────────────────────────────────────────────────
# Withink V2 — Production Environment Variables (Vercel)
# Copy these values into your Vercel project (apps/app → app.withink.me).
# Never commit real secrets. All vars are validated by src/config/env.ts (Zod).
# NOTE: NODE_ENV is set automatically by Vercel to "production" — do not set it.
# ─────────────────────────────────────────────────────────────

# Runtime -------------------------------------------------------
# "true" selects the production database + prod auth config.
# Keep "false" on preview deployments (Vercel previews) so cookies don't
# get pinned to .withink.me and break on *.vercel.app.
IS_PROD=true

# Database (MongoDB) -------------------------------------------
# Reachable from Vercel (IP allowlist or Atlas–Vercel integration).
# Better Auth + Mongoose will use the "withink_prod" database automatically.
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net

# Authentication (Better Auth) ---------------------------------
# 32+ char random string, DIFFERENT from dev. Generate: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# The auth server's own URL (the main app, NOT the docs site).
BETTER_AUTH_URL=https://app.withink.me

# OAuth — Google
# Same OAuth app as dev; add the prod callback in Google Cloud Console:
#   https://app.withink.me/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cache (Upstash Redis, optional — app works without it) -------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Object storage (Cloudflare R2) -------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Server-side public asset base (must be HTTPS in production)
R2_PUBLIC_URL=https://assets.withink.me
# Client-exposed public asset base (must mirror R2_PUBLIC_URL).
# REQUIRED at build time — src/config/public-env.ts throws if missing.
NEXT_PUBLIC_R2_PUBLIC_URL=https://assets.withink.me

# Email (Resend) -----------------------------------------------
# Verify the withink.me domain in Resend (SPF/DKIM) before sending.
RESEND_API_KEY=
EMAIL_FROM=Withink <noreply@withink.me>
# Where feedback / issue reports are delivered.
CONTACT_EMAIL=team@withink.me

# Encryption ---------------------------------------------------
# 64 hex chars = 32 bytes (AES-256). Generate a FRESH key for prod
# (encrypted data cannot be decrypted with a different key).
# Generate: `openssl rand -hex 32`
ENCRYPTION_KEY=
