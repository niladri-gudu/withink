# ─────────────────────────────────────────────────────────────
# Withink V2 — Dev / Staging Environment Variables (Vercel)
# For the separate Vercel project that deploys the `dev` branch
# to https://dev.withink.me (Production Branch = dev).
#
# Values mirror local development (.env.local) EXCEPT BETTER_AUTH_URL,
# which must be the dev deployment's public URL (not localhost).
# With IS_PROD=false the app behaves like local: dev DB (withink_dev),
# email verification off, no cross-subdomain cookies, local-style CSP.
# ─────────────────────────────────────────────────────────────

# Runtime -------------------------------------------------------
# MUST be "false" for dev — prevents touching the prod DB and keeps
# cookies scoped to dev.withink.me (never .withink.me).
IS_PROD=false

# Database (MongoDB) -------------------------------------------
# Dev cluster from .env.local. Better Auth uses "withink_dev" because IS_PROD=false.
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net

# Authentication (Better Auth) ---------------------------------
# Use the same dev secret as .env.local (32+ chars).
BETTER_AUTH_SECRET=
# The dev deployment's own public URL (NOT localhost — callback/email links must work).
BETTER_AUTH_URL=https://dev.withink.me

# OAuth — Google
# Same dev OAuth app as .env.local. Add redirect URI in Google Cloud Console:
#   https://dev.withink.me/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cache (Upstash Redis, optional) ------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Object storage (Cloudflare R2) -------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=https://assets.withink.me

# Email (Resend) -----------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=withink. <noreply@withink.me>
CONTACT_EMAIL=team@withink.me

# Encryption ---------------------------------------------------
# Same dev ENCRYPTION_KEY as .env.local (64 hex chars).
ENCRYPTION_KEY=

# Billing (Dodo Payments, optional) ----------------------------
# Without these the app runs on the Free tier; checkout/portal/webhook
# surfaces show a clear "billing unavailable" error instead.
# Create products in the Dodo dashboard (test mode first), then paste ids.
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_PRODUCT_PLUS_MONTHLY=
DODO_PRODUCT_PLUS_YEARLY=
DODO_PRODUCT_PRO_MONTHLY=
DODO_PRODUCT_PRO_YEARLY=

# Monitoring (Sentry, optional) --------------------------------
# Leave blank locally to keep monitoring off. The first-party fallback
# (/api/monitoring/errors) still logs boundary errors to the dev console.
# The DSN is public by design and safe to expose to the browser.
NEXT_PUBLIC_SENTRY_DSN=
# Optional private DSN override for the server/edge runtimes.
SENTRY_DSN=
# Browser-visible environment tag (dev / production / preview).
NEXT_PUBLIC_SENTRY_ENVIRONMENT=dev
# Build-only source-map upload — never expose these to the client.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
