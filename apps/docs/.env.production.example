# ─────────────────────────────────────────────────────────────
# Withink V2 Docs — Production Environment Variables (Vercel)
# Copy these values into your Vercel project (apps/docs → withink.me).
# The docs site does NOT run Better Auth — no secrets, no BETTER_AUTH_URL.
# NOTE: NODE_ENV is set automatically by Vercel to "production" — do not set it.
# ─────────────────────────────────────────────────────────────

# Runtime -------------------------------------------------------
# Enables production metadataBase (https://withink.me) and the
# app.withink.me fallback. Keep "false" on preview deployments.
IS_PROD=true

# Main app URL --------------------------------------------------
# Where the docs' Sign In / Get Started / Open Sanctuary links point.
# Build-time only; optional (falls back to https://app.withink.me in prod).
NEXT_PUBLIC_APP_URL=https://app.withink.me
