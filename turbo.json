{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "IS_PROD",
        "R2_PUBLIC_URL",
        "R2_ACCOUNT_ID",
        "NEXT_PUBLIC_APP_URL",
        "BETTER_AUTH_URL",
        "MONGODB_URI",
        "BETTER_AUTH_SECRET",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_REST_TOKEN",
        "R2_ACCESS_KEY_ID",
        "R2_SECRET_ACCESS_KEY",
        "R2_BUCKET_NAME",
        "RESEND_API_KEY",
        "EMAIL_FROM",
        "CONTACT_EMAIL",
        "ENCRYPTION_KEY",
        "NEXT_PUBLIC_SENTRY_DSN",
        "SENTRY_DSN",
        "SENTRY_ENVIRONMENT",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "SENTRY_AUTH_TOKEN",
        "DODO_API_KEY",
        "DODO_WEBHOOK_SECRET",
        "DODO_PRODUCT_PLUS_MONTHLY",
        "DODO_PRODUCT_PLUS_YEARLY",
        "DODO_PRODUCT_PRO_MONTHLY",
        "DODO_PRODUCT_PRO_YEARLY",
        "DODO_PRODUCT_PRO_LIFETIME"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "format": {
      "cache": false
    }
  }
}
