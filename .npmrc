# pnpm configuration for the withink monorepo.
#
# Node is pinned to v24.11.x (see .nvmrc) — v24.13+ bundles a c-ares regression
# that breaks `mongodb+srv://` SRV resolution on Windows. Do not upgrade until
# Node ships the c-ares 1.34.6 DNS fix.

auto-install-peers=true
strict-peer-dependencies=false
